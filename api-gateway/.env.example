# Server Configuration
PORT=8080
NODE_ENV=development

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Proxy Timeout (milliseconds)
