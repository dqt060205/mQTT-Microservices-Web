PORT=3004
NODE_ENV=development

# Database owned by this service only (order_db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/order_db?schema=public"

# Must be the same secret user-service uses to sign JWTs
JWT_SECRET=change-me

# Other services (called over REST)
CART_SERVICE_URL=http://localhost:3003
PRODUCT_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3005
REQUEST_TIMEOUT_MS=5000
