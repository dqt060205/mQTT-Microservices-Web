generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

// One row per payment ATTEMPT. A failed attempt never blocks a retry for the same order;
// at most one SUCCESS per order is enforced in payment.service.js.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.VarChar(64)
  userId         String        @map("user_id") @db.VarChar(64)
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus
  provider       String        @default("demo") @db.VarChar(40)
  providerRef    String?       @map("provider_ref") @db.VarChar(120)
  failureReason  String?       @map("failure_reason") @db.VarChar(120)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(100)
  refundedAt     DateTime?     @map("refunded_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([userId, createdAt])
  @@map("payments")
}
