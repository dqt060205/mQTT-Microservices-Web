NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_db?schema=public
JWT_SECRET=replace-with-the-same-secret-used-by-user-service
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Demo provider (no real bank is contacted) ---
# Simulated latency of the "bank", in milliseconds (0-10000)
PAYMENT_DEMO_DELAY_MS=300
# Probability (0-1) that the demo bank declines a payment. 0 = always succeed
PAYMENT_DEMO_FAIL_RATE=0
# Decline every payment above this amount (deterministic, handy for demos). Empty = no limit
PAYMENT_DEMO_MAX_AMOUNT=
