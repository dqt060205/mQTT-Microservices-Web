# true  = run entirely on in-browser mock data (no backend needed)
# false = call the real API through the API Gateway
VITE_USE_MOCK=true

# Dev proxy target for /api (API Gateway)
VITE_GATEWAY_URL=http://localhost:8080

# Base URL the browser calls in production builds (nginx proxies /api to the gateway)
# VITE_API_URL=/api
